CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Hugging Face (free) - Qwen-Image via Spaces:
HF_TOKEN=
# Free stock video (story backgrounds):
PEXELS_API_KEY=
PIXABAY_API_KEY=
